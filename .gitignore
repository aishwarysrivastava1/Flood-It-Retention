# ---------------------------------------------------------------------------
# Credentials: NEVER commit these. Google service-account keys are JSON, and a
# leaked key in a public repository is a real security incident.
# ---------------------------------------------------------------------------
*.json
.config/
*.pem
*.key
.env
.env.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.python-version

# Virtual environments (.venv, .venv-1, venv, env, ...)
.venv*/
venv*/
env/
ENV/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---------------------------------------------------------------------------
# Exported data: keep the repo small. Everything here is rebuilt by running
# notebook 01 against BigQuery in a couple of minutes. Two small summary files
# are allow-listed because the README and the memo quote them.
# ---------------------------------------------------------------------------
data/processed/*
!data/processed/.gitkeep
!data/processed/retention_summary.csv
!data/processed/model_comparison.csv

# ---------------------------------------------------------------------------
# Test-harness artifacts: generated by tests/*.py, never committed
# ---------------------------------------------------------------------------
tests/_simulated/
tests/_sandbox/
*.parquet
*.duckdb

# ---------------------------------------------------------------------------
# Markdown: only the README and the decision memo are published. The working
# documents (analysis plan, data dictionary, metric definitions, runbook,
# interview prep, audit log, dashboard spec) stay on this machine - they are
# used while working, but they are not part of what is shared on GitHub.
# ---------------------------------------------------------------------------
*.md
!README.md
!reports/decision_memo.md

# ---------------------------------------------------------------------------
# OS and editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
*.log
*.tmp
scratch/
